# 編集: sops edit --input-type dotenv --output-type dotenv .enc.env

# 以下の値は .enc.env に SOPS で保存する（この例には実値を書かない）
OPENAI_API_KEY=
SSID=
PASS=
# just live-init で生成。Vercel と本体で共有するデバイス認証用トークン
DEVICE_TOKEN=
# 接続先ホストを指定する既存形式。実際の通信は同じホストの /api/live を使う
REALTIME_TOKEN_URL=https://your-project.vercel.app/api/realtime/token
# Terraform 専用。対象チームを操作できる Vercel API トークン。本体・Vercel 環境変数には渡さない
VERCEL_API_TOKEN=
